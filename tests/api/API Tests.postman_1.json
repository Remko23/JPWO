            "exec": [
              "pm.test(\"API-IAM-02: Brak tokena - Status 401 Unauthorized\", function () {\n    pm.response.to.have.status(401);\n});\n\npm.test(\"API-IAM-02: Zwrot błędu braku autoryzacji w JSON\", function () {\n    var jsonData = pm.response.json();\n    var errorMessage = jsonData.title || jsonData.detail || jsonData.error || \"\";\n    pm.expect(errorMessage.toLowerCase()).to.include(\"unauthorized\");\n});"
            ]
          }
        }
