    {
      "name": "API-INV-01: Utworzenie ruchu magazynowego (POST +)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"API-INV-01: Utworzenie ruchu magazynowego - Status 200/201\", function () {\n    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\n});\n\npm.test(\"API-INV-01: Odpowiedź zawiera id i status\", function () {\n    var jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"id\");\n    pm.expect(jsonData.status).to.eql(\"POSTED\");\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"itemId\": 1,\n  \"locationId\": 1,\n  \"qtyDelta\": 50,\n  \"unitCost\": 10.00,\n  \"reason\": \"Stock in\"\n}",
